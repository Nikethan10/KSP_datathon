# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Heavy regenerable artifacts ───────────────────────────────────────
# feature_matrix.parquet alone is 134 MB, over GitHub's 100 MB hard limit
cache/
# (backtest_scored_test.parquet lives here too — regenerate with
#  `python -m evaluate.backtest`)

# Pipeline outputs (~134 MB / 690 files). Regenerate with `python main.py`
# (~22 min). The frontend does NOT read these directly — copy_data.py
# copies what the UI needs into frontend/public/data, which IS committed.
outputs/

# ── Build output + Catalyst staging ──────────────────────────────────
frontend/dist/
client/assets/
client/data/
client/brand/
client/index.html
client/favicon.svg
client/icons.svg

# Stale Vite scaffold from `catalyst init` — not the real frontend
react-app/

# ── Node ─────────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/
*.log

# ── IDE / editor config ───────────────────────────────────────────────
.claude/
frontend/.claude/
.vscode/
.idea/

# ── Git history tooling (one-off, not part of the project) ───────────
fix_commits.py
_msg_filter.py

# NOTE: the precompute_*.py / rerun_*.py scripts are NOT ignored. They
# produce most of frontend/public/data — offender dossiers, the novelty
# layer, district trends, patrol scenarios, calibration and the
# socio-economic panel. main.py's nine stages do not cover them. Ignoring
# them made the public repo unable to regenerate its own data.

# ── Source media (large originals; processed versions in frontend/public/brand) ──
prahari_loadingscreen.mp4
prahari_logo.jpg
scratch_preview.png

# ── OS ───────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
*.tmp

# ── Catalyst project binding ─────────────────────────────────────────
# Contains the project id, environment id and dev domain. Not a secret in
# itself, but it targets our deployment; the values are documented in
# docs/DEPLOY.md so a fresh clone can re-init its own.
.catalystrc

# ── Submission deliverables (built artefacts, not source) ────────────
# The deck is regenerated by build_ppt.js from the KSP template plus
# screenshots/; the Word docs are exports. None of them are read by the
# application, and the .pptx alone is ~9 MB.
*.pptx
*.docx
KSP Datathon 2026  Prototype Submission Template.pdf

# Console captures used to build the deck — regenerate with
# `node capture_screenshots.js` against a running dev server.
screenshots/

# One-off submission tooling, same category as fix_commits.py above.
build_ppt.js
capture_screenshots.js
# Superseded by build_ppt.js — generated the pre-template deck, which is itself
# ignored above. Kept locally, out of the repo.
make_ppt.py
# Scratch import check from early pipeline work: no assertions, no runner.
test_skeleton.py

# Root-level Node deps exist only for the deck/screenshot tooling.
# The application's own manifest is frontend/package.json.
/package.json
/package-lock.json
