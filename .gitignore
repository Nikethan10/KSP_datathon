# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Heavy regenerable artifacts ───────────────────────────────────────
# feature_matrix.parquet alone is 134 MB, over GitHub's 100 MB hard limit
cache/

# Pipeline outputs (~134 MB / 690 files). Regenerate with `python main.py`
# (~22 min). The frontend does NOT read these directly — copy_data.py
# copies what the UI needs into frontend/public/data, which IS committed.
outputs/

# ── Build output + Catalyst staging ──────────────────────────────────
frontend/dist/
client/assets/
client/data/
client/brand/
client/index.html
client/favicon.svg
client/icons.svg

# Stale Vite scaffold from `catalyst init` — not the real frontend
react-app/

# ── Node ─────────────────────────────────────────────────────────────
frontend/node_modules/
node_modules/
*.log

# ── IDE / editor config ───────────────────────────────────────────────
.claude/
frontend/.claude/
.vscode/
.idea/

# ── Git history tooling (one-off, not part of the project) ───────────
fix_commits.py
_msg_filter.py

# NOTE: the precompute_*.py / rerun_*.py scripts are NOT ignored. They
# produce most of frontend/public/data — offender dossiers, the novelty
# layer, district trends, patrol scenarios, calibration and the
# socio-economic panel. main.py's nine stages do not cover them. Ignoring
# them made the public repo unable to regenerate its own data.

# ── Source media (large originals; processed versions in frontend/public/brand) ──
prahari_loadingscreen.mp4
prahari_logo.jpg
scratch_preview.png

# ── OS ───────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
*.tmp

# ── Catalyst project binding ─────────────────────────────────────────
# Contains the project id, environment id and dev domain. Not a secret in
# itself, but it targets our deployment; the values are documented in
# docs/DEPLOY.md so a fresh clone can re-init its own.
.catalystrc
